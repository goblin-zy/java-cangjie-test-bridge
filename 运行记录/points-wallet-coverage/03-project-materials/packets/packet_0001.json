    {
      "record_type": "source",
      "value": {
        "file_id": "java_business:wallet/PointsWallet.java",
        "start_line": 1,
        "end_line": 21,
        "content": "package wallet;\n\npublic final class PointsWallet {\n    private int points;\n\n    public PointsWallet(int points) {\n        this.points = points;\n    }\n\n    public boolean spend(int amount) {\n        if (amount > points) {\n            return false;\n        }\n        points -= amount;\n        return true;\n    }\n\n    public int balance() {\n        return points;\n    }\n}"
      }
    },
